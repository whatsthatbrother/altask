# ───────────────────────── helpers ─────────────────────────
def now_iso():
    return datetime.now().isoformat(timespec="seconds")


def fmt_short(iso):
    try:
        d = datetime.fromisoformat(iso)
    except Exception:
        return ""
    today = datetime.now().date()
    hm = d.strftime("%H:%M")
    if d.date() == today:
        return f"today {hm}"
    if (today - d.date()).days == 1:
        return f"yesterday {hm}"
    return f"{MONTHS[d.month - 1][:3]} {d.day}, {hm}"


def fmt_today():
    d = datetime.now()
    return f"{DAYS[d.weekday()]}, {MONTHS[d.month - 1]} {d.day}, {d.year}"


def set_dpi_aware():
    if not IS_WIN:
        return
    try:
        ctypes.windll.shcore.SetProcessDpiAwareness(1)
    except Exception:
        try:
            ctypes.windll.user32.SetProcessDPIAware()
        except Exception:
            pass


def work_area(root):
    """Screen area without the taskbar: (left, top, right, bottom)."""
    if IS_WIN:
        try:
            class RECT(ctypes.Structure):
                _fields_ = [("left", ctypes.c_long), ("top", ctypes.c_long),
                            ("right", ctypes.c_long), ("bottom", ctypes.c_long)]
            r = RECT()
            ctypes.windll.user32.SystemParametersInfoW(0x0030, 0, ctypes.byref(r), 0)
            if r.right > r.left and r.bottom > r.top:
                return r.left, r.top, r.right, r.bottom
        except Exception:
            pass
    return 0, 0, root.winfo_screenwidth(), root.winfo_screenheight()


def system_is_light():
    if not IS_WIN:
        return False
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER,
                            r"Software\Microsoft\Windows\CurrentVersion\Themes\Personalize") as k:
            return winreg.QueryValueEx(k, "AppsUseLightTheme")[0] == 1
    except OSError:
        return False


def resource(*parts):
    base = getattr(sys, "_MEIPASS", os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(base, *parts)


def set_app_id():
    """Own taskbar identity, so Windows doesn't reuse a stale (old) icon for this app."""
    if IS_WIN:
        try:
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("DiarF.Tasks")
        except Exception:
            pass


def has_font(root, family):
    try:
        return tkfont.Font(root=root, family=family, size=10).actual("family").lower() == family.lower()
    except Exception:
        return False


_mutex = None


def single_instance():
    global _mutex
    if not IS_WIN:
        return True
    try:
        _mutex = ctypes.windll.kernel32.CreateMutexW(None, False, "Local\\DetyratNoteApp")
        return ctypes.windll.kernel32.GetLastError() != 183  # ERROR_ALREADY_EXISTS
    except Exception:
        return True


# ───────────────────── start with Windows ─────────────────────
RUN_KEY = r"Software\Microsoft\Windows\CurrentVersion\Run"


def autostart_cmd():
    if getattr(sys, "frozen", False):
        return f'"{sys.executable}"'
    exe = sys.executable
    w = os.path.join(os.path.dirname(exe), "pythonw.exe")
    if os.path.exists(w):
        exe = w
    return f'"{exe}" "{os.path.abspath(__file__)}"'


def autostart_get():
    if not IS_WIN:
        return None
    import winreg
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, RUN_KEY) as k:
            return winreg.QueryValueEx(k, APP_ID)[0]
    except OSError:
        return None


def autostart_set(on):
    if not IS_WIN:
        return
    import winreg
    with winreg.OpenKey(winreg.HKEY_CURRENT_USER, RUN_KEY, 0, winreg.KEY_SET_VALUE) as k:
        if on:
            winreg.SetValueEx(k, APP_ID, 0, winreg.REG_SZ, autostart_cmd())
        else:
            try:
                winreg.DeleteValue(k, APP_ID)
            except OSError:
                pass


# ───────────────────────── storage ─────────────────────────
class Store:
    def __init__(self):
        self.data = {"tasks": [],
                     "settings": {"width": 340, "topmost": True, "collapsed": False,
                                  "show_done": True, "theme": "system",
                                  "confirm_delete": True, "text_size": "large"}}
        self.load()

    @property
    def tasks(self):
        return self.data["tasks"]

    @property
    def settings(self):
        return self.data["settings"]

    def load(self):
        try:
            with open(DATA_FILE, encoding="utf-8") as f:
                d = json.load(f)
            self.data["tasks"] = list(d.get("tasks", []))
            self.data["settings"].update(d.get("settings", {}))
        except FileNotFoundError:
            pass
        except Exception:
            try:  # corrupted file -> keep a backup and start clean
                os.replace(DATA_FILE, DATA_FILE + ".bak")
            except Exception:
                pass

    def save(self):
        os.makedirs(DATA_DIR, exist_ok=True)
        tmp = DATA_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.data, f, ensure_ascii=False, indent=2)
        os.replace(tmp, DATA_FILE)


